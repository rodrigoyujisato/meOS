# ==============================================================================
# rysOS: configuração. Copie para .env (cp .env.example .env) e preencha.
# Todas as variáveis são opcionais, exceto onde indicado.
# ==============================================================================

# --- Quem é o dono do assistente ---------------------------------------------
# Nome como aparece nas notas e nas mensagens.
USER_NAME=Seu Nome
# Cargo/papel, usado nos prompts (ex.: "diretora financeira", "empreendedor").
USER_ROLE=executivo
# Todas as contas Google que você usa, separadas por vírgula. Servem para reconhecer
# você entre os participantes de uma reunião. Contas @gmail.com/@outlook.com etc. são
# tratadas como "pessoais"; qualquer outro domínio, como "corporativo".
USER_EMAILS=voce@gmail.com,voce@suaempresa.com

# --- Cofre Obsidian -----------------------------------------------------------
# Pasta do cofre (crie-a ou aponte para um cofre existente). `rysos init-vault` monta
# a estrutura PARA dentro dela.
OBSIDIAN_VAULT_PATH=~/Obsidian/rysos-vault

# --- Google Gemini (necessário para as funções de IA) ------------------------
# Gere uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

# --- Google OAuth (Gmail + Agenda) -------------------------------------------
# Arquivo "OAuth client ID (Desktop app)" baixado do Google Cloud Console.
# Passo a passo no README, seção "Configurar as credenciais".
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# --- Telegram (opcional) ------------------------------------------------------
# Token do @BotFather. Sem ele, o bot fica desligado.
TELEGRAM_BOT_TOKEN=
# IDs numéricos de quem pode falar com o bot, separados por vírgula. VAZIO = ninguém
# é autorizado. Para descobrir o seu, envie qualquer mensagem ao bot: ele responde com o ID.
TELEGRAM_ALLOWED_USER_IDS=
# Chat que recebe o resumo da manhã e o balanço da noite (normalmente o seu próprio ID).
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Servidor web -------------------------------------------------------------
# A interface web NÃO tem autenticação: deixe em 127.0.0.1. Para acesso remoto, use
# uma VPN (ex.: Tailscale) ou um túnel com controle de acesso na frente.
HOST=127.0.0.1
PORT=8000

# --- Rotinas e fuso -----------------------------------------------------------
TIMEZONE=America/Sao_Paulo
MORNING_BRIEF_TIME=07:00
EVENING_RECAP_TIME=19:00

# --- Banco de dados local (SQLite) -------------------------------------------
# Por padrão fica em data/rysos.db dentro do projeto. Só defina para mudar o caminho.
# DATABASE_URL=sqlite+aiosqlite:///data/rysos.db
